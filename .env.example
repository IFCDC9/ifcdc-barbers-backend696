# Copy relevant sections into `backend/.env` — root `server.js` imports `loadBackendEnv.mjs` first (absolute path to that file).
# Never commit your real `backend/.env`.
# Vite keeps its own `client/.env` for VITE_* (separate from this API env).
#
# Project paths:
# - Backend: /Users/fahrealallah/Documents/ifcdc-barbers-backend 2
# - Mobile:  /Users/fahrealallah/Documents/ifcdc-barbers-backend 2/mobile

# =========================
# SERVER
# =========================
PORT=5050
# Main API (`src/server.js`) binds to 0.0.0.0:PORT so phones on the same Wi‑Fi can reach the server.
NODE_ENV=development
# Dev: do not serve client/dist on this port (API only; use Vite :5174). Production: omit or set NODE_ENV=production to serve SPA.
# IFCDC_API_ONLY=1
# Dev: serve built SPA from :5050 like production (overrides API-only default in development).
# IFCDC_SERVE_SPA=1
# Dev only: POST /auth/login always succeeds (no credential check). Unset or 0 in production.
# IFCDC_LOGIN_BYPASS=1
# Production fail-fast env checks (or use NODE_ENV=production):
# IFCDC_STRICT_ENV=true
# Backend-only host without Vite vars in process.env:
# SKIP_VITE_ENV_VALIDATION=true

# =========================
# DATABASE (Postgres / Supabase)
# =========================
# Local example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ifcdc_barbers
#
# Supabase — copy the URI from Dashboard → Project Settings → Database (use "URI" tab).
# Error 28P01 = wrong password: reset DB password in Supabase and update this line.
# Special characters in password must be URL-encoded in the URI.
# Direct:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Pooler — use ONE URI only (do not mix with direct db.*.supabase.co:5432 in the same env).
# Transaction pooler (port 6543), user postgres.YOUR_PROJECT_REF:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Session pooler (port 5432) — copy exact string from Supabase Dashboard → Database if 6543 fails.

# Optional pool tuning (defaults are small for dev)
# PG_POOL_MAX=1
# PG_IDLE_TIMEOUT_MS=10000
# PG_CONNECTION_TIMEOUT_MS=10000

# =========================
# SUPABASE (optional — style photo uploads to Storage)
# =========================
# If unset, uploads are saved under ./uploads/barber-styles and served at /uploads/...
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public key (prefer new publishable key; legacy anon JWT still works):
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only (never expose in the browser) — prefer secret key or legacy service_role:
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Create a public bucket with this name (or change):
# SUPABASE_STORAGE_BUCKET=barber-styles
#
# Vite (client/) — optional; same project URL for URL builders in the browser:
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=eyJ...   (fallback if publishable unset)
# VITE_SUPABASE_STORAGE_BUCKET=barber-styles

# =========================
# JWT AUTH
# =========================
JWT_SECRET=YOUR_JWT_SECRET
# JWT_EXPIRES_IN=7d

# Google Sign-In (POST /api/auth/google).
# MUST be the Web application OAuth client ID from Google Cloud Console — NOT the iOS or Android client ID.
# Must match the Expo app Web client (expoClientId / GOOGLE_EXPO_CLIENT_ID). Restart the server after changing this.
# Optional: native client IDs — if set, ID tokens issued to those clients are accepted too (Expo iOS/Android).
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# =========================
OPENAI_API_KEY=YOUR_OPENAI_KEY

# =========================
# TWILIO (SMS / CALL AI)
# =========================
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
# SMS: Twilio Messaging Service SID (MG…) — required for voice booking sendConfirmationSMS. No API `from`.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Voice “Call Now” (POST /api/call) caller ID — optional; not used for SMS.
TWILIO_PHONE_NUMBER=+13313168167
# Status callbacks: set Messaging Service Integration to POST https://YOUR_PUBLIC_HOST/api/sms/status

# Validate X-Twilio-Signature on POST /api/aura/voice and POST /api/aura/sms (recommended in production).
# When true, TWILIO_AUTH_TOKEN must match the account that signs webhooks or Twilio returns 403.
# Leave false for local curl tests without a Twilio signature.
# TWILIO_VALIDATE_SIGNATURE=false

# Public URL Twilio can reach (must NOT be localhost). Required for correct TwiML redirects.
# Production (Render): https://<your-service>.onrender.com — see docs/PRODUCTION_BASE_URL.md
# On Render, PUBLIC_BASE_URL is optional — the server uses RENDER_EXTERNAL_URL when unset.
# Twilio → Voice webhook: POST https://<your-service>.onrender.com/voice (never localhost)
PUBLIC_BASE_URL=https://your-service.onrender.com

# Public SPA for invite, password-reset, and booking email links (NOT the API host).
# Password reset emails must use this — never PUBLIC_BASE_URL / RENDER_EXTERNAL_URL.
FRONTEND_URL=https://ifcdcbarbersapp.com
APP_URL=https://ifcdcbarbersapp.com
PUBLIC_WEB_FALLBACK_URL=https://ifcdc-barbers-frontend.onrender.com
# Optional override in some voice flows:
# VOICE_WEBHOOK_BASE_URL=https://your-public-host.example

# =========================
# PAYPAL (server-side REST API)
# =========================
# invalid_client = wrong secret, wrong app, or sandbox/live mismatch.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
# Prefer PAYPAL_CLIENT_SECRET; PAYPAL_SECRET is an alias (both trimmed — no spaces)
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SECRET
# PAYPAL_SECRET=YOUR_PAYPAL_SECRET
# sandbox (default if unset) = Sandbox app credentials only. live = Live app only — do not mix.
# Must match the PayPal app that issued PAYPAL_CLIENT_ID + PAYPAL_CLIENT_SECRET (sandbox OR live — never mixed).
PAYPAL_ENV=sandbox
# Render production (ifcdc-barbers-backend696): use live credentials → PAYPAL_ENV=live
# Checkout: same public client id as PAYPAL_CLIENT_ID — required for reliable PayPal JS when API is another host; restart Vite after change
# VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Default USD full service price + deposit (PayPal create-order + /api/book verify against these)
# BOOKING_PRICE_USD=25
# BOOKING_DEPOSIT_USD=10
# Set to false to hide deposit option (client: VITE_BOOKING_DEPOSIT_ENABLED=false)
# BOOKING_DEPOSIT_ENABLED=true

# =========================
# PAYMENTS TABLE (Option A)
# =========================
# Automatically created on first PayPal order/capture if missing:
# - payments(booking_id → appointments.id, paypal_order_id, amount, status, created_at)

# Optional: mark stale pending payments as failed
# PAYMENTS_CLEANUP_OLDER_THAN_MINUTES=30

# =========================
# EMAIL (SMTP)
# =========================
# Used for booking confirmation emails and /api/notifications/test-email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
# SMTP_FROM="IFCDC Barbers <you@example.com>"

# =========================
# SUPER ADMIN (Postgres app_users — service@ifcdc.org)
# =========================
# Passwords are bcrypt-hashed only; never commit real values.
# One-time: set a strong password (12+ chars, upper, lower, number, symbol; not "admin123") then run:
#   SUPER_ADMIN_PASSWORD='YourStr0ng!Secret' npm run set-super-admin-password
# Optional: SUPER_ADMIN_EMAIL=service@ifcdc.org
#
# First server boot when no super_admin row exists: set a bootstrap password here (same strength rules):
# SUPER_ADMIN_BOOTSTRAP_PASSWORD='YourStr0ng!Secret'
# (or reuse SUPER_ADMIN_PASSWORD for bootstrap)

# =========================
# ADMIN
# =========================
# Server: required for POST /api/barbers/styles, /api/admin/*, HubSpot verify/test-contact
# (header x-admin-key). MUST match Render → ifcdc-barbers-backend696 → ADMIN_SECRET.
# Align from production (never commit the real value):
#   RENDER_API_KEY=rnd_... node scripts/align-admin-secret-from-render.mjs --write
ADMIN_SECRET=admin123

# Website (Vite): MUST match ADMIN_SECRET — stored as ifcdc_admin_key after admin login
VITE_ADMIN_API_KEY=admin123

# =========================
# HUBSPOT (Phase 1+)
# =========================
# Prefer Render-only for HUBSPOT_SERVICE_KEY. Local optional for scripts:
# HUBSPOT_SERVICE_KEY=
# HUBSPOT_SYNC_ENABLED=1
# Phase 2A — barbershops → Companies (requires HUBSPOT_SYNC_ENABLED=1 as well):
# HUBSPOT_SYNC_COMPANIES=1
# Phase 2B — appointments → Deals:
# HUBSPOT_SYNC_DEALS=1
# Optional HubSpot pipeline stage IDs (portal-specific; omit to rely on ifcdc_appointment_status):
# HUBSPOT_DEAL_PIPELINE_ID=
# HUBSPOT_DEAL_STAGE_SCHEDULED=
# HUBSPOT_DEAL_STAGE_PAID=
# HUBSPOT_DEAL_STAGE_COMPLETED=
# HUBSPOT_DEAL_STAGE_CANCELLED=
# HUBSPOT_DEAL_STAGE_NO_SHOW=

# If the SPA is hosted separately from the API, set the backend origin only (no /api suffix).
# Wrong: https://host.com/api — causes /api/api/... and HTTP 404. Right: https://host.com
# VITE_API_BASE=https://your-backend.onrender.com
# Laptop: set `VITE_API_BASE` only when you must (recommended: leave empty and use Vite proxy).
# Phone on same Wi‑Fi: use LAN IP if needed, e.g. VITE_API_BASE=http://192.168.1.135:10000
# Local Vite dev (`cd client && npm run dev`): proxy forwards /api to the backend. Default port 10000.
# If your API listens elsewhere: VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:7070
# Vite binds on LAN when host is enabled (default). To bind localhost only: VITE_DEV_BIND_ALL=false
# VITE_DEV_PORT=5173

# Business line for the Phone tab (GET /api/config → `phone`)
# Optional platform fallback when a shop has no `businesses.phone` in the database.
# Shops should set their public line in Settings (PUT /api/shop/detail). Example IFCDC fallback:
# BUSINESS_PHONE=+17327435048
# Optional AURA / SMS line (GET /api/config → `auraPhone`). Mirror in client/.env as VITE_AURA_PHONE_NUMBER for the chat header.
# Required in `backend/.env` — no quotes, no trailing slash, no spaces around `=`.
# Terminal 1: `npm run dev`  Terminal 2: `npm run tunnel` → paste the https host here.
# PUBLIC_API_URL=https://abc123.ngrok-free.app
# Twilio Console → your number → “A call comes in” → Webhook POST → `https://abc123.ngrok-free.app/api/aura/voice`
# Same base for SMS: `https://abc123.ngrok-free.app/api/aura/sms`
# Twilio Voice “A call comes in” → POST `https://<PUBLIC_API_URL>/api/aura/voice` (TwiML + speech Gather).
# Twilio Messaging (SMS) when using this app as webhook → POST `https://<PUBLIC_API_URL>/api/aura/sms` (TwiML &lt;Message&gt;).
# Optional: shared secret for programmatic POST /api/book with JSON { "channel": "aura_voice", ... } and header x-voice-booking-secret.
# VOICE_BOOKING_SECRET=generate-a-long-random-string
# Placeholder email for voice bookings when the caller does not provide one (Resend may require a valid inbox for real sends).
# VOICE_DEFAULT_CUSTOMER_EMAIL=bookings+voice@yourdomain.com
# AURA_PHONE_NUMBER=+15555551212
# Voice: default is OpenAI simple loop on POST /api/aura/voice. Set to use legacy state-machine booking wizard instead:
# AURA_VOICE_WIZARD=1
# Chat POST /api/aura: allow AURA when barber is Free tier (dev / demos only):
# AURA_ALLOW_FREE_TIER_CHAT=1

# =========================
# APP URLS (optional documentation only)
# =========================
# Backend base URL (local dev):
# BASE_URL=http://127.0.0.1:5050
# Mobile Metro (dev server):
# MOBILE_URL=http://127.0.0.1:8081
#
# Mobile app (Expo) — same Supabase project as DATABASE_URL:
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# EXPO_PUBLIC_SHOP_PHONE_DIGITS=3315550100
# EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=barber-styles
#
# Server: SUPABASE_SERVICE_ROLE_KEY is required for POST /api/auth/supabase-bridge (maps app JWT → Supabase user).

# =========================
# PROCESS MANAGER (optional)
# =========================
# From repo root after `npm install` (includes pm2 as devDependency):
#   npm run pm2:start
#   npm run pm2:save
#   npx pm2 startup   # follow printed command for reboot persistence

