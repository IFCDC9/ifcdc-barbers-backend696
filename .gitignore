# IFCDC Barbers — production .gitignore (UTF-8)

# local DB exports (contain production data)
backups/

# dependencies
node_modules/
**/node_modules/
.pnpm-store/
.yarn/

# env / secrets
.env
.env.*
!.env.example
backend/.env
mobile/.env
mobile/.env.local
env_backup/
.vscode/.env
credentials.json
mobile/credentials.json

# build / cache
.expo/
**/.expo/
mobile/.expo/
mobile/web-build/
mobile/dist/
mobile/.metro-cache/
client/dist/
**/.cache/
**/.turbo/
dist/
build/

# temp / sandbox folders
mobile/temp-app/
tmp/
*.tmp
.DS_Store
**/.DS_Store

# corrupt / archived lock files (never commit)
mobile/package-lock__corrupt_*.json
*.bak
*.orig

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# runtime uploads (server-managed, never source-control)
uploads/
mobile/uploads/
backend/uploads/

# local Python tooling deps
tools/_pydeps/
__pycache__/
*.pyc

# editor
.idea/
.vscode/

# native build artifacts (Expo prebuild output)
mobile/ios/
mobile/android/
*.xcworkspace/xcuserdata/
*.pbxuser

# EAS local build cache
mobile/.eas/
