# Copy to `client/.env`. Vite loads only `client/` (see vite.config.js envDir) — not repo root `.env`.
#
# --- Local dev (recommended) ---
# Backend: repo root `npm run dev` → API on 0.0.0.0:5050
# Frontend: `cd client && npm run dev` → Vite :5173 proxies /api, /barbers, /uploads, /health to the API.
# Leave VITE_API_BASE unset so the app uses same-origin paths + proxy (no CORS).
#
# --- Phone / LAN: API on another machine or LAN IP ---
# Point the Vite dev proxy at your API (read by vite.config.js):
# VITE_DEV_API_PROXY_TARGET=http://192.168.1.10:5050
# VITE_API_BASE=http://192.168.1.10:5050
#
# --- Production build (npm run build in client/) ---
# Render Static Site: `client/.npmrc` sets production=false so dev tooling installs if needed.
# Set at build time on Render:
# VITE_API_BASE=https://ifcdc-barbers-backend696.onrender.com
#
# VITE_API_BASE=

# Admin API (must match server ADMIN_SECRET). Sent as `x-admin-key` when no JWT — used by Admin panel + style/barber management.
# VITE_ADMIN_API_KEY=your-strong-secret

# PayPal (Booking/Checkout) — required on Render Static Site at build time
# VITE_PAYPAL_CLIENT_ID=<same Live Client ID as root PAYPAL_CLIENT_ID>
# VITE_PAYPAL_ENVIRONMENT=production
#
# Platform fee shown in checkout (must match server PLATFORM_FEE / 0.99 default)
# VITE_PLATFORM_FEE=0.99
# Optional — shown under the AURA title in the chat panel (tel: link). Should match root AURA_PHONE_NUMBER.
# VITE_AURA_PHONE_NUMBER=+15555551212
#
# Optional build-time fallback if the shop has no DB phone yet (prefer shop Settings).
# VITE_BUSINESS_PHONE=+17327435048
#
# Booking page pricing (display + PayPal amount); must match server BOOKING_* when set
# VITE_BOOKING_PRICE=25
# VITE_BOOKING_DEPOSIT=10
# VITE_BOOKING_DEPOSIT_ENABLED=true

# MULTI_LANGUAGE_DROPDOWN_V2 — keep OFF in production until QA approval.
# VITE_MULTI_LANGUAGE_DROPDOWN_V2=1
