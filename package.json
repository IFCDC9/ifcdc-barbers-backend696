{
  "name": "ifcdc-barbers-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npx -y kill-port 10000 || exit 0",
    "start": "node server.js",
    "dev": "node server.js",
    "dev:watch": "npx -y nodemon --legacy-watch server.js",
    "dev:api": "node server.js",
    "dev:client": "npm run dev --prefix client -- --host",
    "dev:all": "concurrently -n api,web -c blue,green \"node server.js\" \"npm run dev --prefix client -- --host\"",
    "dev:full": "npm run dev:all",
    "tunnel": "ngrok http 10000",
    "build": "node -e \"const {execSync}=require('child_process');try{require('fs').writeFileSync('DEPLOY_COMMIT.txt',execSync('git rev-parse HEAD',{encoding:'utf8'}).trim())}catch(e){console.warn('[build] DEPLOY_COMMIT.txt skipped',e.message)} console.log('[build] backend ready')\"",
    "verify:rewards-rateme": "node scripts/verify-rewards-rateme-production.mjs",
    "verify:storage": "node scripts/verify-supabase-production.mjs",
    "audit:rls": "node --import ./loadBackendEnv.mjs scripts/audit-supabase-rls.mjs",
    "audit:security": "node --import ./loadBackendEnv.mjs scripts/audit-supabase-security.mjs",
    "apply:rls": "node --import ./loadBackendEnv.mjs scripts/apply-supabase-rls.mjs",
    "apply:function-hardening": "node --import ./loadBackendEnv.mjs scripts/apply-supabase-function-hardening.mjs",
    "backup:db": "node --import ./loadBackendEnv.mjs scripts/backup-supabase-db.mjs",
    "verify:password-reset": "node --import ./loadBackendEnv.mjs scripts/verify-password-reset-flow.mjs",
    "verify:service-photos": "node --import ./loadBackendEnv.mjs scripts/verify-service-photo-workflow.mjs",
    "verify:domains": "node scripts/verify-public-domains.mjs",
    "verify:invite": "node scripts/verify-invite-deployment.mjs",
    "verify:cleanup": "node scripts/verify-production-cleanup.mjs",
    "capture:asc-screenshots": "node scripts/capture-asc-screenshots.mjs",
    "upload:asc-screenshots": "node scripts/upload-asc-screenshots.mjs",
    "test:resend": "node scripts/test-resend.cjs",
    "test:paypal": "node scripts/verify-paypal-oauth.cjs",
    "test:security": "node tests/securityPolicy.test.mjs",
    "test:loyalty": "node tests/loyaltyEngine.test.mjs",
    "test:aura-phase2": "node --test tests/auraPhase2Flags.test.mjs tests/auraPhase2Tools.test.mjs tests/auraDailyReport.test.mjs tests/auraPhase2Reminders.test.mjs",
    "aura:daily-report": "node --import ./loadBackendEnv.mjs scripts/run-aura-daily-report.mjs",
    "test:hubspot": "node tests/hubspotPhase1.test.mjs && node tests/hubspotPhase2aCompanies.test.mjs && node tests/hubspotPhase2bDeals.test.mjs && node tests/hubspotPhase2cWorkflows.test.mjs && node tests/hubspotPhase2dAnalytics.test.mjs",
    "smoke:phase2": "node scripts/smoke-phase2-production.mjs",
    "backfill:booking-business-id": "node --import ./loadBackendEnv.mjs scripts/backfill-booking-business-id.mjs",
    "hubspot:setup-workflows": "node --import ./loadBackendEnv.mjs scripts/hubspot-setup-phase2c-workflows.mjs",
    "hubspot:backfill": "node --import ./loadBackendEnv.mjs scripts/hubspot-backfill-companies-deals.mjs",
    "hubspot:strip-d8ui": "node scripts/render-strip-d8ui-hubspot.mjs",
    "verify:hubspot": "node --import ./loadBackendEnv.mjs scripts/verify-hubspot-phase1.mjs",
    "test:photos": "node --import ./loadBackendEnv.mjs scripts/test-photo-pipeline.mjs",
    "test:photos:prod": "node --import ./loadBackendEnv.mjs scripts/test-photo-production-verification.mjs",
    "bootstrap-super-admin": "node scripts/setSuperAdminPassword.mjs --generate"
  },
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@paypal/paypalhttp": "^1.0.1",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.19.0",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pg": "^8.20.0",
    "resend": "^6.10.0",
    "sentiment": "^5.0.2",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.9",
    "playwright": "^1.60.0",
    "sharp": "^0.35.1"
  }
}
