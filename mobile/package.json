{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "node scripts/postinstall-ngrok.cjs",
    "prestart": "node scripts/verify-app-json.cjs",
    "prelan": "node scripts/verify-app-json.cjs",
    "prelan:clear": "node scripts/verify-app-json.cjs",
    "prelan:clear:sim": "node scripts/verify-app-json.cjs",
    "prestart:clear": "node scripts/verify-app-json.cjs",
    "pretunnel": "node scripts/verify-app-json.cjs",
    "pretunnel:clear": "node scripts/verify-app-json.cjs",
    "preandroid": "node scripts/verify-app-json.cjs",
    "preios": "node scripts/verify-app-json.cjs",
    "preios:lan": "node scripts/verify-app-json.cjs",
    "preweb": "node scripts/verify-app-json.cjs",
    "metro:kill": "node ../scripts/kill-metro-8081.cjs",
    "deps:repair": "rm -rf node_modules && npm install",
    "start": "npm run metro:kill && env -u CI expo start",
    "tunnel": "npm run metro:kill && env -u CI expo start --tunnel",
    "start:clear": "npm run metro:kill && env -u CI expo start --clear",
    "tunnel:clear": "npm run metro:kill && env -u CI expo start --tunnel --clear",
    "lan": "npm run metro:kill && env -u CI expo start --lan",
    "lan:clear": "npm run metro:kill && env -u CI expo start --lan --clear",
    "lan:clear:sim": "npm run metro:kill && env -u CI sh -c 'REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --lan --clear'",
    "android": "npm run metro:kill && env -u CI expo start --android",
    "ios": "npm run metro:kill && env -u CI expo start --ios",
    "ios:lan": "npm run metro:kill && env -u CI expo start --lan --clear --ios",
    "web": "npm run metro:kill && env -u CI expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@supabase/supabase-js": "^2.101.1",
    "axios": "^1.14.0",
    "dotenv": "^17.4.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.10",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-voice": "^0.3.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "cacheable-request": "^7.0.4",
    "@types/react": "~19.1.0",
    "babel-plugin-polyfill-corejs2": "^0.4.17",
    "eas-cli": "^18.9.1",
    "jest-worker": "29.7.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "jest-worker": "29.7.0"
  }
}
