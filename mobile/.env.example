# Production (default for device / TestFlight-style testing):
EXPO_PUBLIC_API_URL=https://ifcdc-barbers-backend696.onrender.com
EXPO_PUBLIC_BACKEND_URL=https://ifcdc-barbers-backend696.onrender.com
EXPO_PUBLIC_WEB_URL=https://ifcdcbarbersapp.com

# MULTI_LANGUAGE_DROPDOWN_V2 — keep OFF in production until QA approval.
# EXPO_PUBLIC_MULTI_LANGUAGE_DROPDOWN_V2=1

# Local simulator only — set EXPO_PUBLIC_USE_LOCAL_API=1 and uncomment:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:10000
# EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:10000

# Optional — mobile uses server-side PayPal; these are diagnostic only:
# EXPO_PUBLIC_PAYPAL_CLIENT_ID=
# EXPO_PUBLIC_PAYPAL_ENV=live
