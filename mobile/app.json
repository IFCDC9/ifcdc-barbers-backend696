{
  "expo": {
    "name": "IFCDC Barbers",
    "owner": "ifcdc696",
    "slug": "ifcdc-barbers-backend",
    "version": "1.1.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "ifcdc-barbers",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ifcdc.barbers",
      "buildNumber": "78",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "IFCDC Barbers uses your photo library so barbers can upload haircut style photos, profile images, and gallery photos that customers can view when booking appointments.",
        "NSPhotoLibraryAddUsageDescription": "IFCDC Barbers saves photos you choose to upload for your profile or barber style gallery.",
        "NSMicrophoneUsageDescription": "IFCDC Barbers uses the microphone only if you choose to use voice features with AURA or speak appointment details.",
        "NSSpeechRecognitionUsageDescription": "IFCDC Barbers uses speech recognition only if you choose to use voice features with AURA, so the app can understand spoken appointment or service requests.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "package": "com.ifcdc.barbers",
      "versionCode": 61,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "ifcdc-barbers"
            },
            {
              "scheme": "ifcdc-barbers",
              "host": "paypal-booking",
              "pathPrefix": "/"
            },
            {
              "scheme": "ifcdc-barbers",
              "host": "paypal-booking"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eeba0d04-6fc7-4359-8a07-f5c0545e6a47"
      },
      "supportsRTL": true,
      "forcesRTL": false,
      "multiLanguageDropdownV2": true,
      "EXPO_PUBLIC_MULTI_LANGUAGE_DROPDOWN_V2": "1"
    }
  }
}
